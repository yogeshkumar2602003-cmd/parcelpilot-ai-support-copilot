# Copy this file to `.env` in this SAME directory (the project root) and
# fill in real values there. Never commit the real .env file -- it's
# gitignored (see .gitignore: `.env` and `.env.*`, with `.env.example`
# explicitly re-allowed).
#
# The backend loads .env from an absolute path derived from its own source
# location (backend/app/config.py), so it finds this file regardless of
# which directory you launch `uvicorn`/`docker run` from.

# Which LLM backend the chat agent uses: "ollama" (local, zero API cost --
# requires Ollama running on this machine, see OLLAMA_BASE_URL/AI_MODEL
# below) or "anthropic" (paid cloud, requires ANTHROPIC_API_KEY below).
AI_PROVIDER=ollama

# --- Ollama (local) settings -- only used when AI_PROVIDER=ollama -------
# Must stay localhost/127.0.0.1 unless you deliberately run Ollama on a
# trusted remote host -- this is never allowed to point at api.anthropic.com.
OLLAMA_BASE_URL=http://localhost:11434
# Must already be pulled: `ollama pull qwen2.5:1.5b`. On a machine with more
# free RAM, `qwen2.5:3b` or larger gives noticeably better answer quality.
AI_MODEL=qwen2.5:1.5b
# Optional: seconds to wait for a local model response (default 120).
# OLLAMA_TIMEOUT_S=120
# Optional: max tokens the model may generate per turn (default 512) --
# caps worst-case latency on slow hardware; the system prompt already asks
# for concise answers so this rarely binds in practice.
# OLLAMA_NUM_PREDICT=512
# Optional: how long Ollama keeps the model loaded in RAM after a request
# (default 30m) -- avoids the reload cost (~15s+ on constrained hardware)
# on every chat message. Lower it if you need that RAM back between uses.
# OLLAMA_KEEP_ALIVE=30m

# --- Anthropic (cloud) settings -- only used when AI_PROVIDER=anthropic -
# Without a key, ingestion, calculations, tests, and Issue Radar still
# work -- the chat endpoint returns a clear structured 503 explaining the
# key is missing instead of crashing. Get a key from
# https://console.anthropic.com/ -- it is a secret, used SERVER-SIDE ONLY,
# and is never sent to the frontend/browser.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_OWN_KEY

# Model id used for the agent's tool-use loop. Kept as an env var so the
# app is never hard-coupled to a specific model id that may be retired.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional overrides (defaults shown):
# PARCELPILOT_DB_PATH=./backend/parcelpilot.db
# PARCELPILOT_MAX_TOOL_DEPTH=8
# PARCELPILOT_BUSINESS_HOURS_START=9
# PARCELPILOT_BUSINESS_HOURS_END=18
# PARCELPILOT_CORS_ORIGINS=*
# PARCELPILOT_LOG_LEVEL=INFO
