# Copy this file to `.env` in this SAME directory (the project root) and
# fill in real values there. Never commit the real .env file -- it's
# gitignored (see .gitignore: `.env` and `.env.*`, with `.env.example`
# explicitly re-allowed).
#
# The backend loads .env from an absolute path derived from its own source
# location (backend/app/config.py), so it finds this file regardless of
# which directory you launch `uvicorn`/`docker run` from.

# Required for the live chat agent. Without it, ingestion, calculations,
# tests, and Issue Radar still work -- the chat endpoint returns a clear
# structured 503 explaining the key is missing instead of crashing.
# Get a key from https://console.anthropic.com/ -- it is a secret, used
# SERVER-SIDE ONLY, and is never sent to the frontend/browser.
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_OWN_KEY

# Model id used for the agent's tool-use loop. Kept as an env var so the
# app is never hard-coupled to a specific model id that may be retired.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional overrides (defaults shown):
# PARCELPILOT_DB_PATH=./backend/parcelpilot.db
# PARCELPILOT_MAX_TOOL_DEPTH=8
# PARCELPILOT_BUSINESS_HOURS_START=9
# PARCELPILOT_BUSINESS_HOURS_END=18
# PARCELPILOT_CORS_ORIGINS=*
# PARCELPILOT_LOG_LEVEL=INFO
